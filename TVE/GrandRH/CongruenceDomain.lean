module

public import Mathlib.Basic.Real.Basic
public import Mathlib.Basic.Complex.Basic
public import TVE.TruncatedDomain

/-!
# Congruence Modular Coverings for Grand RH

Generalizes the modular surface \(Y = \mathrm{SL}(2,\mathbb{Z})\backslash\mathbb{H}\)
to the congruence covering surfaces \(Y_0(N) = \Gamma_0(N)\backslash\mathbb{H}\)
generated by composite braided Beltrami flux tubes of conductor level \(N\).
-/

set_option linter.style.whitespace false
set_option linter.style.header false
set_option linter.style.longLine false
set_option linter.style.longLine false


public section

namespace TVE

/-- The conductor level \(N\) of the braided Beltrami flux tube configuration. -/
axiom ConductorLevel : ℕ

/-- The congruence subgroup \(\Gamma_0(N) \subset \mathrm{SL}(2,\mathbb{Z})\). -/
axiom CongruenceSubgroup (N : ℕ) : Type

/-- A cuspidal automorphic representation \(\pi\) (or Dirichlet character \(\chi \bmod N\))
    defining the internal Aharonov-Bohm phase holonomies. -/
axiom AutomorphicRep : Type

/-- The dual (contragredient) representation \(\widetilde{\pi}\). -/
axiom dualRep (π : AutomorphicRep) : AutomorphicRep

/-- The twisted automorphic local system \(\mathcal{L}_\pi\) over the congruence surface. -/
axiom AutomorphicLocalSystem (π : AutomorphicRep) : Type

/--
The congruence modular surface \(Y_0(N)_a\) truncated at the minor-radius cutoff \(y=a\).
Provides the geometric domain for the generalized Lax-Phillips truncation.
-/
axiom Y_0_N_a (N : ℕ) (a : ℝ) : Type

end TVE
