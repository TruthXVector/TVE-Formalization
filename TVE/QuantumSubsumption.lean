theorem qm_lagrange_cauchy_schwarz_and_ccr_int :
    qmLagrangeCSDefectInt 3 4 1 2 = qmSymplecticWedgeSqInt 3 4 1 2 ∧
    qmLagrangeCSDefectInt 2 (-5) 3 1 = qmSymplecticWedgeSqInt 2 (-5) 3 1 ∧
    (∀ u1 u2 v1 v2 : ℤ, qmIsNonNegInt (qmSymplecticWedgeSqInt u1 u2 v1 v2) = true) ∧
    qmLagrangeCSDefectInt 1 0 0 1 = 1 ∧
    posRatLt (posRatOfInt 0) { num := 1, denPred := 3 } = true ∧
    posRatLt { num := 1, denPred := 3 } (posRatOfInt 1) = true :=
  ⟨rfl, rfl, fun u1 u2 v1 v2 => qm_int_sq_nonneg (u1 * v2 - u2 * v1), rfl, rfl, rfl⟩

/--
